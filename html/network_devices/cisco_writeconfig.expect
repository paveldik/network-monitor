# cisco_writeconfig.expect
# Сохранение текущей конфигурации Cisco-коммутатора в энергонезависимую память.
# Расположение: /html/network_devices/cisco_writeconfig.expect
# Входные параметры: argv[0] — IP-адрес коммутатора; учетные данные читаются
# из системной конфигурации.
# Выход: отправляет команду сохранения; вывод Expect — stdout.
# Пример вызова: expect /var/www/html/network_devices/cisco_writeconfig.expect 192.168.22.10
# @author  Pavel Dik: paveldik@gmail.com
# @version 1.0
set timeout 10
set script_dir [file dirname [file normalize [info script]]]
source [file join $script_dir network-monitor-config.tcl]
set network_monitor_config [load_network_monitor_config]
set address [lindex $argv 0]

spawn telnet $address
expect "sername: "
send "[dict get $network_monitor_config CISCO_USERNAME]\r"
expect "assword: "
send "[dict get $network_monitor_config CISCO_PASSWORD]\r"
expect ">"
send "en\r"
expect "assword: "
send "[dict get $network_monitor_config CISCO_ENABLE_PASSWORD]\r"
expect "#"
send "write\r"
expect "#"
send "logout\r"
