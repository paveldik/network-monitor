# cisco_interface_change_poe_status.expect
# Изменение режима PoE выбранного интерфейса Cisco-коммутатора.
# Расположение: /html/network_devices/cisco_interface_change_poe_status.expect
# Входные параметры: argv[0] — IP-адрес, argv[1] — интерфейс, argv[2] — режим
# PoE; учетные данные берутся из системной конфигурации.
# Выход: команда изменения PoE отправляется коммутатору; вывод Expect — stdout.
# Пример вызова: expect /var/www/html/network_devices/cisco_interface_change_poe_status.expect 192.0.22.10 Gi1/0/1 auto
# @author  Pavel Dik: paveldik@gmail.com
# @version 1.0
set timeout 5
set script_dir [file dirname [file normalize [info script]]]
source [file join $script_dir network-monitor-config.tcl]
set network_monitor_config [load_network_monitor_config]
set address [lindex $argv 0]
set interface [lindex $argv 1]
set status [lindex $argv 2]

spawn telnet $address
expect "sername: "
send "[dict get $network_monitor_config CISCO_USERNAME]\r"
expect "assword: "
send "[dict get $network_monitor_config CISCO_PASSWORD]\r"
expect ">"
send "en\r"
expect "assword: "
send "[dict get $network_monitor_config CISCO_ENABLE_PASSWORD]\r"
expect "#"
send "conf t\r"
expect "#"
send "int $interface\r"
expect "#"
send "power inline $status\r"
expect "#"
send "exit\r"
expect "#"
send "exit\r"
expect "#"
send "logout\r"
